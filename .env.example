# Copy to .env.local for `npm run dev`; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- LLM (Google Gemini, free tier) -------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite (fast and reliably available on the free tier).
# gemini-3.6-flash follows tool instructions better but is often busy; when it fails or takes
# over 8 s to start, requests fall back to GEMINI_FALLBACK_MODEL.
GEMINI_MODEL=
# Optional. Default: gemini-3.5-flash-lite. Set to "none" to disable the fallback.
GEMINI_FALLBACK_MODEL=
# Optional: MINIMAL | LOW | MEDIUM | HIGH. Unset = model default.
GEMINI_THINKING_LEVEL=

# --- Rate limiting (Upstash Redis via the Vercel Marketplace, free plan) ------
# The Vercel integration injects KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
# Without them an in-memory limiter is used (fine locally, per-instance on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Defaults: 20 messages per 600 seconds per visitor.
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
# Optional global cap per rolling 24h, to stay inside the free LLM quota. 0/empty = off.
CHAT_DAILY_LIMIT=
# Random string used to hash visitor IPs before they become rate-limit keys.
IP_HASH_SALT=

# --- Security & features --------------------------------------------------------
# Extra origins allowed to call /api/chat (the deployment's own origin is always allowed).
ALLOWED_ORIGINS=
# true = enable the webSearch tool (Wikipedia, no key needed). Default: off.
WEB_SEARCH_ENABLED=false
