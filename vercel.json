{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.ts": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/Giovanny_Lino_CV_DevOps_PT.pdf", "destination": "/Giovanny_Lino_CV_PT.pdf", "permanent": true },
    { "source": "/Giovanny_Lino_Resume_DevOps_EN.pdf", "destination": "/Giovanny_Lino_Resume_EN.pdf", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
